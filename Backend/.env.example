# Django reads Backend/.env locally; process environment takes precedence.
DJANGO_SETTINGS_MODULE=rideflow.settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/?replicaSet=trivia-rs
MONGODB_DATABASE=trivia
# Atlas: use a secret mongodb+srv:// URI, with the same database name setting.
MONGODB_TEST_URI=mongodb://localhost:27017/?replicaSet=trivia-rs
MONGODB_TEST_NAME=test_trivia_mongodb
# MYSQL_* / DB_* values are only read by the explicit legacy read-only export.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CACHE_REDIS_URL=redis://127.0.0.1:6379/2
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=7
# Dotted class path with send(phone, code). No SMS provider is bundled.
SMS_PROVIDER=
# Explicit LOCAL ONLY: DJANGO_DEBUG=true + TRIVIA_LOCAL_OTP=true +
# SMS_PROVIDER=accounts.services.authentication.LocalSMS
TRIVIA_LOCAL_OTP=false
# Isolated local development only; never enable on a public backend.
TRIVIA_TEST_OTP_ENABLED=false
TRIVIA_TEST_OTP_PHONES=
# Separate secret for rideflow.development only (at least 32 characters).
TRIVIA_DEV_SECRET_KEY=
TRIVIA_DEV_MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=trivia-rs
TRIVIA_DEV_MONGODB_DATABASE=trivia_dev_local
# Provision licensed HTTPS OSRM/Nominatim-compatible services.
TRIVIA_ROUTING_URL=
TRIVIA_GEOCODING_URL=
TRIVIA_MAX_SNAP_METRES=250
TRIVIA_QUOTE_TTL_SECONDS=300
DRIVER_LOCATION_TTL=90
DRIVER_LOCATION_MIN_INTERVAL=3
DRIVER_MATCH_RADIUS_KM=8
RIDE_REQUEST_TTL=300
OFFER_TTL=90
LOCATION_RETENTION_DAYS=7
PRIVATE_MEDIA_ROOT=/app/private_media
# Optional adapter implements notifications.services.push.PushProvider
PUSH_PROVIDER=
# Production reverse proxy only; ingress must strip untrusted forwarded headers.
TRUST_PROXY_SSL_HEADER=false

# Render production: set DJANGO_SETTINGS_MODULE=rideflow.production
# Set explicit public ALLOWED_HOSTS and HTTPS browser origins (comma separated).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Shared private S3-compatible media; install requirements-storage.txt.
# Bucket must block public access. Never set a public ACL or CDN domain.
PRIVATE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
PRIVATE_STORAGE_BUCKET=
PRIVATE_STORAGE_REGION=
PRIVATE_STORAGE_ENDPOINT=
PRIVATE_STORAGE_ACCESS_KEY=
PRIVATE_STORAGE_SECRET_KEY=

# Password recovery. Web and Celery worker need matching delivery configuration.
# SMS recovery uses the real SMS_PROVIDER configured above.
TRIVIA_RECOVERY_EMAIL_ENABLED=false
TRIVIA_VERIFIED_RECOVERY_EMAILS={}
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
