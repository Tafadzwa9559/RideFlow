# Export these variables in your environment/secret manager; settings do not
# automatically read .env files. Never commit real credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DB_ENGINE unset to preserve the existing local SQLite configuration.
# Set mysql only for a provisioned MySQL database, then run migrations there.
# DB_ENGINE=mysql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Operator-provisioned HTTPS OSRM-compatible routing and Nominatim-compatible
# geocoding services. No public demo server or provider API key is assumed.
TRIVIA_ROUTING_URL=
TRIVIA_GEOCODING_URL=
TRIVIA_MAX_SNAP_METRES=250
TRIVIA_QUOTE_TTL_SECONDS=300
TRIVIA_EXCHANGE_MAX_AGE_SECONDS=86400
TRIVIA_EXCHANGE_SOURCE_HOSTS=www.rbz.co.zw,rbz.co.zw
# Rates and rate-verification evidence are configured in Django admin, not here.
